<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.2.3.RELEASE</version>
        <relativePath/>
    </parent>

    <groupId>com.lcy</groupId>
    <artifactId>yun-music</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>yun-music</name>
    <description>Yun Music Website</description>

    <modules>
        <module>common-utils</module>
        <module>ms-client</module>
        <module>ui-client</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis.starter.version>1.3.2</mybatis.starter.version>
        <druid.version>1.1.14</druid.version>
        <java-jwt.version>3.10.3</java-jwt.version>
    </properties>

    <!-- spring-boot-maven-plugin 只在打包成可执行 jar 的模块中声明；
         库模块 common-utils 不声明，否则 repackage 会报 "Unable to find main class" -->
</project>
